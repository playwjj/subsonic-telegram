{
  "name": "subsonic-telegram",
  "version": "0.1.0",
  "description": "Subsonic API server on Cloudflare Workers, backed by Telegram as file storage",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 execute subsonic-telegram --local --file=./db/schema.sql",
    "db:migrate:remote": "wrangler d1 execute subsonic-telegram --remote --file=./db/schema.sql",
    "import": "tsx scripts/import.ts",
    "sync-tgfs": "tsx scripts/sync-tgfs.ts",
    "import-m3u": "tsx scripts/import-m3u.ts"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260911.1",
    "@types/node": "^22.20.2",
    "tsx": "^4.19.2",
    "typescript": "^7.0.2",
    "wrangler": "^4.131.1"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "music-metadata": "^10.6.4"
  }
}
