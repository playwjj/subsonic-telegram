{
  "name": "subsonic-telegram",
  "version": "0.1.0",
  "description": "Subsonic API server on Cloudflare Workers, backed by Telegram as file storage",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/playwjj/subsonic-telegram.git"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "build": "npm --prefix web ci && npm --prefix web run build",
    "web:dev": "npm --prefix web run dev",
    "db:migrate:local": "wrangler d1 execute subsonic-telegram --local --file=./db/schema.sql",
    "db:migrate:remote": "wrangler d1 execute subsonic-telegram --remote --file=./db/schema.sql",
    "import": "tsx scripts/import.ts",
    "import-m3u": "tsx scripts/import-m3u.ts",
    "fix-covers": "tsx scripts/fix-covers.ts",
    "fix-covers:remote": "tsx scripts/fix-covers-remote.ts"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260911.1",
    "@types/node": "^22.20.2",
    "tsx": "^4.19.2",
    "typescript": "^7.0.2",
    "wrangler": "^4.131.1"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "music-metadata": "^10.6.4",
    "opencc-js": "^1.4.2"
  }
}
