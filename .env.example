# Telegram — used by both the Worker (as secrets) and the import script.
TG_BOT_TOKEN=
# Full chat id, including the -100 prefix.
TG_CHANNEL_ID=

# Cloudflare — only needed by the import script (talks to D1 over the HTTP API,
# since D1 bindings only work from inside a Worker).
CF_ACCOUNT_ID=
# API token needs "D1 Edit" permission for the account.
CF_API_TOKEN=
# From `wrangler d1 create subsonic-telegram`.
D1_DATABASE_ID=

# Only needed by scripts/import-m3u.ts — local path to the music library,
# used to resolve .m3u entries to already-imported tracks via source_path.
# Must match the directory you pass to `npm run import`.
LOCAL_MUSIC_DIR=
