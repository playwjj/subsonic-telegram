# Telegram — used by both the Worker (as secrets) and the import script.
TG_BOT_TOKEN=
# Full chat id, including the -100 prefix (Bot API form, not TGFS's truncated form).
TG_CHANNEL_ID=

# Cloudflare — only needed by the import script (talks to D1 over the HTTP API,
# since D1 bindings only work from inside a Worker).
CF_ACCOUNT_ID=
# API token needs "D1 Edit" permission for the account.
CF_API_TOKEN=
# From `wrangler d1 create subsonic-telegram`.
D1_DATABASE_ID=

# Only needed by scripts/sync-tgfs.ts — pulls in tracks already uploaded via
# the alice-creator/TGFS pipeline (same bot/channel) without re-uploading
# bytes. See that script's header comment for how it works.
# owner/repo of TGFS's file-index git repo (its `tgfs.metadata` GitHub backend).
TGFS_GITHUB_REPO=
# Needs read access to that repo.
TGFS_GITHUB_TOKEN=
# Optional: local path to the same music library, used to fill in
# duration/bitrate/tags. Leave unset to fall back to folder/filename parsing.
LOCAL_MUSIC_DIR=
